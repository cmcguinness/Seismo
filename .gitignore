# Python
__pycache__/
*.py[cod]
.venv/
venv/

# CAD build output
stl/

# quake_share.py output images (regenerate from the archive via the tool)
eq_*.png

# IDE
.idea/

# OS
.DS_Store

# FastHTML session-signing secret (auto-generated at runtime; never commit)
.sesskey

# Pixelmator source for doc images (large; JPEG export is the tracked asset)
*.pxd

# KiCad: VS Code Local History extension drops a NESTED git repo in here
interface_board/**/.history/
# KiCad transient/user-local state (not design data)
*.kicad_prl
*-backups/
fp-info-cache

# Traffic collection working data (personal; regenerate features via traffic_features.py)
labels.csv
labels.events.csv
labels.features.csv
analysis/labels.csv
analysis/labels.events.csv
analysis/labels.features.csv
!analysis/labels.example.csv
# annotations.csv is NOT ignored: unlike labels.csv (bulk, regenerable traffic
# counts), it is hand-observed ground truth -- someone watched the thing happen and
# wrote down when. It only exists on one Mac, so it belongs in the repo.

# USGS seismicity dump for detection_map.py (3 MB, re-fetchable — see the
# module docstring for the query). State outlines ARE committed: they are small
# and the map is unusable without them.
analysis/geo/seismicity.geojson

# template_match.py templates -- rebuildable from event_harvest.csv + the archive
analysis/templates.npz
