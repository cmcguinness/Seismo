[Unit]
Description=Seismo geophone recorder (geophone -> miniSEED day-files)
Documentation=https://github.com/cmcguinness/Seismo
# Need pigpiod for SPI/GPIO, and a synced clock for accurate sample timestamps.
After=network-online.target time-sync.target pigpiod.service
Wants=network-online.target time-sync.target
Requires=pigpiod.service

[Service]
Type=simple
User=charles
Group=charles
WorkingDirectory=/home/charles/seismo/station
# Station config (defaults match recorder.py; here so the deployment is self-documenting)
Environment=SEISMO_NETWORK=SS
Environment=SEISMO_STATION=OAKM1
# EHZ, not SHZ: FDSN sets the band code by sample rate -- E is 80-249 sps, S is
# 10-79 -- so SHZ stopped being correct at the 100 sps cutover (2026-07-25).
Environment=SEISMO_CHANNEL=EHZ
Environment=SEISMO_LOCATION=00
Environment=SEISMO_GAIN=64
Environment=SEISMO_DRATE=100
# RDATAC: free-running continuous read -- the ADC samples on its own crystal at
# exactly DRATE (measured 0 gaps vs 41.2 s/hour lost on the legacy per-sample-SYNC
# path). Declared rate = DRATE, so each rate change starts a NEW EPOCH: files are not
# mergeable across it, and the prior day-files are renamed *.<rate>sps-epoch at cutover.
# 100 sps epoch (2026-07-25): a back-to-back RDATAC measurement on this hardware
# REVERSED the old bring-up call -- 100 sps is LOWER noise in the quake band than 60
# (1-15 Hz 2.74 vs 3.99 uV, 3-15 Hz 2.62 vs 3.86), sustains cleanly (99.91 sps, 5
# glitches/90 s; the "~92 sps ceiling" was the legacy SYNC path, not RDATAC), and
# lifts Nyquist 30->50 Hz. Cost: 60 Hz mains no longer falls on a sinc notch (aliases
# to 40 Hz, above the quake band -- digital notch in post if it bothers a spectrum).
Environment=SEISMO_RDATAC=1
Environment=SEISMO_RATE=100
# C reader (station/adsreader): the ADS1256 is owned by a small C process that takes
# DRDY as a kernel interrupt with hardware timestamps and streams samples over a pipe.
# Every lost conversion is counted and filled; blocks are timed from the data. The
# pigpio in-process path (SEISMO_READER=pigpio) lost ~0.2 % of samples silently and
# put an 18 ms gap after every block -- STATUS.md 2026-08-25 "RECORDER".
Environment=SEISMO_READER=c
# UDP publisher -> pi5 collector (rev2-data-plane.md sec 14.10 Phase-1 step 1). Streams
# each packed record ALONGSIDE the local day-files; fail-open, never touches acquisition.
Environment=SEISMO_UDP_HOST=192.168.5.30
Environment=SEISMO_UDP_PORT=48317
Environment=SEISMO_UDP_N=2
Environment=SEISMO_HB_PORT=48318
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/charles/seismo/venv/bin/python recorder.py
# recorder.py traps SIGTERM -> flushes the partial block and releases the ADC
KillSignal=SIGTERM
# Let adsreader take SCHED_FIFO and lock its pages (it warns and carries on without).
LimitRTPRIO=60
LimitMEMLOCK=64M
TimeoutStopSec=20
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
