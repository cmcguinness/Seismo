[Unit]
# Seismo environmental node logger -- reads the CLUE over USB serial, appends
# UTC-stamped rows to daily CSV in ~/env-data. Install on pi4env:
#   sudo cp env-logger.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now env-logger
Description=Seismo environmental node logger (CLUE -> daily CSV)
After=multi-user.target

[Service]
Type=simple
User=charles
ExecStart=/home/charles/env_node/.venv/bin/python /home/charles/env_node/env_logger.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
