// Copy to wifi_secrets.h and fill in. wifi_secrets.h is gitignored --
// this repo is public, so credentials must never be committed.
#pragma once
#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"
#define SEISMO_HOST   "192.168.5.30"   // pi5. Use the IP, not the name: the ESP32
                                       // resolves via the router's DNS, which may
                                       // not know a bare LAN hostname.
#define SEISMO_PORT   8351
