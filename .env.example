# Cloudflare R2 credentials for pi5/r2_backup.sh.
# Copy to ~/.config/seismo/r2.env on pi5 and chmod 600. THIS REPO IS PUBLIC — the real
# .env is gitignored, and only this example is tracked.

R2_BUCKET_NAME=seismo

# HOST ONLY. Cloudflare's bucket page labels
#   https://<account-id>.r2.cloudflarestorage.com/<bucket>
# as the "S3 API" URL, but that is endpoint + bucket path; rclone appends the bucket
# again and everything silently lands under /<bucket>/<bucket>/. r2_backup.sh strips
# any trailing path, so either form works — but the host-only form is the correct one.
R2_S3_API=https://<account-id>.r2.cloudflarestorage.com

R2_AUTH_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
